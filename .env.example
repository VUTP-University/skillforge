POSTGRES_DB=skillforge
POSTGRES_USER=skillforge
POSTGRES_PASSWORD=skillforge

SQLALCHEMY_DATABASE_URI=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
JWT_COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173

# Rate limiting (Flask-Limiter syntax). Defaults are generous because whole
# classrooms register from one campus NAT IP. Use redis://host:6379 for storage
# in any multi-process deployment.
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://
REGISTER_RATE_LIMIT=30 per hour
LOGIN_RATE_LIMIT=20 per minute; 200 per hour

# Used for Stack Trace process challenges and the admin Job AI Assistant
OPENAI_API_KEY=

# Vite proxy target — use http://backend:5000 when running in Docker
VITE_API_TARGET=http://localhost:5000
